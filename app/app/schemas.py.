from pydantic import BaseModel, Field
from typing import List, Optional
from datetime import datetime

class EvidenceCreate(BaseModel):
    source: str
    content: str

class EvidenceRead(BaseModel):
    id: int
    source: str
    content: str
    created_at: datetime

    class Config:
        orm_mode = True

class QueryCreate(BaseModel):
    text: str

class QueryRead(BaseModel):
    id: int
    text: str
    created_at: datetime

    class Config:
        orm_mode = True

class BriefCreate(BaseModel):
    summary: str
    details: Optional[str] = None

class BriefRead(BaseModel):
    id: int
    summary: str
    details: Optional[str]
    created_at: datetime

    class Config:
        orm_mode = True

class IntentCreate(BaseModel):
    name: str
    description: Optional[str] = None
    queries: Optional[List[QueryCreate]] = Field(default_factory=list)
    evidences: Optional[List[EvidenceCreate]] = Field(default_factory=list)
    briefs: Optional[List[BriefCreate]] = Field(default_factory=list)

class IntentRead(BaseModel):
    id: int
    name: str
    description: Optional[str]
    queries: List[QueryRead] = []
    evidences: List[EvidenceRead] = []
    briefs: List[BriefRead] = []
    created_at: datetime

    class Config:
        orm_mode = True
